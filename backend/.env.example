# Copiar este archivo como ".env" y completar con los datos reales.
# El archivo ".env" esta en .gitignore: NUNCA se sube a GitHub.

# --- Base de datos PostgreSQL en Supabase ---
# Supabase > Project Settings > Database > Connection string > "Session pooler" (puerto 5432).
# Usuario del pooler: postgres.<project-ref>
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=CAMBIAR

# --- Seguridad (JWT) ---
# Minimo 32 caracteres. Generar uno propio, por ejemplo: openssl rand -base64 48
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRATION_MINUTES=480

# --- Desarrollo local sin Supabase (docker compose --profile local up) ---
# DB_URL=jdbc:postgresql://postgres-local:5432/panol
# DB_USER=panol
# DB_PASSWORD=panol
